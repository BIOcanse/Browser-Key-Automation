{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "../out/extension"
  },
  "include": ["src/chrome.d.ts", "src/content/**/*.ts"]
}
